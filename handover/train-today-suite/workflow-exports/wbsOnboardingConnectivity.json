{
  "id": "wbsOnboardingConnectivity",
  "name": "WBS Onboarding — connectivity only",
  "nodes": [
    {
      "id": "webhook",
      "name": "Connectivity Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "fb3df0e8-d447-43e4-a267-60a866d16ce1",
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "wbs-onboarding-connectivity",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Onboarding Webhook Secret (Header Auth)"
        }
      }
    },
    {
      "id": "departments",
      "name": "Read Departments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "url": "http://api:3001/api/internal/departments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Departments API Secret (Header Auth)"
        }
      }
    },
    {
      "id": "callback",
      "name": "Callback Schema Probe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:3001/api/internal/onboarding/result",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Internal API Secret (Header Auth)"
        }
      }
    },
    {
      "id": "summary",
      "name": "Connectivity Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{departments_count:$('Read Departments').first().json.data.length,callback_http_status:$json.statusCode,callback_error_code:$json.body.error.code,mutated_employee:false}}];"
      }
    }
  ],
  "connections": {
    "Connectivity Webhook": {
      "main": [
        [
          {
            "node": "Read Departments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Departments": {
      "main": [
