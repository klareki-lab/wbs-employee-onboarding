          {
            "node": "Callback Schema Probe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback Schema Probe": {
      "main": [
        [
          {
            "node": "Connectivity Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
