# Separate Employee Onboarding SMTP. Copy to backend/.env.smtp, chmod 600, then edit.
# Do NOT copy credentials or senders from Messe Hub or another production service.
# Use your provider's exact SMTP hostname and an independently authorized sender.
SMTP_HOST=smtp.your-authorized-provider.invalid
# STARTTLS: port 587 with false. Implicit TLS: port 465 with true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Quote the secret so Compose does not interpolate dollar signs, e.g. 'your value'.
SMTP_PASSWORD=
SMTP_FROM=
