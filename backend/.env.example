NODE_ENV=development
PORT=3001
# Host port for Docker Compose only; change if 3001 is in use
API_PORT=3001
DATABASE_URL=postgresql://onboarding:onboarding_local_only@localhost:54329/onboarding
APP_ORIGIN=http://localhost:5173
# Generate a private value: openssl rand -hex 32
INTERNAL_API_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional separate read-only credential for the Info Agent
# DEPARTMENTS_API_SECRET=replace-with-a-separate-random-secret
# Leave unset until a NEW onboarding workflow has been provisioned.
# N8N_ONBOARDING_WEBHOOK_URL=http://localhost:5681/webhook/wbs-onboarding
# N8N_ONBOARDING_WEBHOOK_SECRET=replace-with-a-separate-random-secret
# capture is for isolated regression tests; real acceptance uses compose.smtp.yaml.
# disabled prevents invitation delivery until real SMTP is configured.
SMTP_MODE=disabled
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=onboarding@example.invalid
# SMTP_USER=
# SMTP_PASSWORD=
SESSION_HOURS=8
INVITATION_HOURS=24
TRUST_PROXY_HOPS=0

# Optional onboarding-authorized AI credential, imported encrypted into isolated local n8n.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
